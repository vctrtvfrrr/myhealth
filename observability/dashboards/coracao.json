          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "with period as (\n  select $__timeFrom()::timestamptz at time zone '$__timezone' as from_local,\n         $__timeTo()::timestamptz at time zone '$__timezone' as to_local,\n         now() at time zone '$__timezone' as now_local\n),\nbuckets as (\n  select generate_series(\n           read_model.local_bucket('$agrupar', from_local),\n           read_model.local_bucket('$agrupar', least(to_local, now_local)),\n           '1 $agrupar'::interval) as bucket\n  from period\n),\nmetric as (\n  select read_model.local_bucket('$agrupar', period_end_local) as bucket,\n         avg(temperature_celsius) as mean,\n         min(min_temperature_celsius) as low,\n         max(max_temperature_celsius) as high\n  from read_model.current_skin_temperature, period\n  where '$agrupar' <> 'hour' and period_end_local >= from_local and period_end_local < to_local\n  group by 1\n  union all\n  select read_model.local_bucket('$agrupar', start_at_local) as bucket,\n         avg(temperature_celsius) as mean,\n         min(min_temperature_celsius) as low,\n         max(max_temperature_celsius) as high\n  from read_model.current_skin_temperature_series, period\n  where '$agrupar' = 'hour' and start_at_local >= from_local and start_at_local < to_local\n  group by 1\n)\nselect b.bucket at time zone '$__timezone' as time,\n       m.mean as \"Média\",\n       m.low as \"Mínimo\",\n       m.high as \"Máximo\"\nfrom buckets b\nleft join metric m on m.bucket = b.bucket\nwhere b.bucket < (select to_local from period)\norder by 1"
