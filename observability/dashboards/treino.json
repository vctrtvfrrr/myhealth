          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select s.position as \"Sessão\",\n       to_char(s.start_at_local, 'HH24:MI') as \"Início\",\n       to_char(s.end_at_local, 'HH24:MI') as \"Fim\",\n       coalesce(s.duration_seconds, extract(epoch from s.end_at - s.start_at)) as \"Duração\",\n       s.exercise_label as \"Tipo\",\n       s.custom_title as \"Título\",\n       s.count as \"Contagem\",\n       s.count_type as \"Tipo de contagem\",\n       s.calories_kilocalories as \"Calorias\",\n       s.distance_meters / 1000 as \"Distância\",\n       s.incline_distance_meters / 1000 as \"Distância em subida\",\n       s.decline_distance_meters / 1000 as \"Distância em descida\",\n       s.altitude_gain_meters as \"Ganho de altitude\",\n       s.altitude_loss_meters as \"Perda de altitude\",\n       s.min_altitude_meters as \"Altitude mín.\",\n       s.max_altitude_meters as \"Altitude máx.\",\n       s.mean_speed_meters_per_second * 3.6 as \"Velocidade média\",\n       s.max_speed_meters_per_second * 3.6 as \"Velocidade máx.\",\n       s.mean_cadence_per_minute as \"Cadência média\",\n       s.max_cadence_per_minute as \"Cadência máx.\",\n       s.mean_calorie_burn_rate_kilocalories_per_hour as \"Queima média\",\n       s.max_calorie_burn_rate_kilocalories_per_hour as \"Queima máx.\",\n       s.mean_power_watts as \"Potência média\",\n       s.max_power_watts as \"Potência máx.\",\n       s.mean_rpm as \"RPM médio\",\n       s.max_rpm as \"RPM máx.\",\n       s.mean_heart_rate_beats_per_minute as \"FC média\",\n       s.min_heart_rate_beats_per_minute as \"FC mín.\",\n       s.max_heart_rate_beats_per_minute as \"FC máx.\",\n       s.vo2_max as \"VO2 max\",\n       case s.auto_detected when true then 'Sim' when false then 'Não' end as \"Detecção automática\",\n       s.comment as \"Comentário\",\n       s.pool_length_meters as \"Piscina\",\n       s.swimming_distance_meters / 1000 as \"Distância nadada\",\n       s.swimming_duration_seconds as \"Duração nadando\"\nfrom read_model.current_exercise_session s\nwhere s.samsung_uid = '$treino'\norder by s.position"
        }
      ]
