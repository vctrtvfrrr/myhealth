      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "myhealth-read"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select to_char(e.period_start_local, 'DD/MM/YYYY HH24:MI') as \"Início\",\n       coalesce(e.exercise_label, 'Sem tipo') as \"Tipo\",\n       e.custom_title as \"Título\",\n       coalesce(e.duration_seconds, extract(epoch from e.period_end - e.period_start)) as \"Duração\",\n       e.distance_meters / 1000 as \"Distância\",\n       e.calories_kilocalories as \"Calorias\",\n       paced.kilometers_per_hour as \"Velocidade\",\n       (paced.seconds_per_km / 60)::text || ':' || lpad((paced.seconds_per_km % 60)::text, 2, '0') || ' /km' as \"Ritmo\"\nfrom read_model.current_exercise e\nleft join lateral (\n  select e.distance_meters / coalesce(e.duration_seconds, extract(epoch from e.period_end - e.period_start)) * 3.6 as kilometers_per_hour,\n         round(coalesce(e.duration_seconds, extract(epoch from e.period_end - e.period_start)) * 1000 / e.distance_meters)::int as seconds_per_km\n  where e.distance_meters > 0 and coalesce(e.duration_seconds, extract(epoch from e.period_end - e.period_start)) > 0\n) paced on true\nwhere e.samsung_uid = '$treino'"
        }
      ]
    },
